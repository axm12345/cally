# Copy to .env.local and fill in. All values are read on the server only.
# Never prefix these with NEXT_PUBLIC_ and never commit .env.local.

# Required: turns the spoken request into { fix, device, when, near }.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: real phone calls through the Vonage caller in caller/ (see README, "Live calls").
# CALLER_URL is the caller's public https address (ngrok). CALLER_TOKEN must equal its LOCAL_CALL_TOKEN.
# LIVE_SHOP_NUMBERS: the Nth number is called for the Nth shop; shops without one use mock results.
CALLER_URL=https://your-tunnel.ngrok-free.app
CALLER_TOKEN=same-as-caller-LOCAL_CALL_TOKEN
LIVE_SHOP_NUMBERS=+66XXXXXXXXX

# Optional, older path (unused when CALLER_* is set): ElevenLabs' own Twilio telephony.
# If ANY of these three is empty, the app runs entirely on mock results.
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
ELEVENLABS_AGENT_ID=agent_your-agent-id-here
ELEVENLABS_PHONE_NUMBER_ID=phnum_your-phone-number-id-here
