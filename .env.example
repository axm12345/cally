# Copy to .env.local and fill in. All values are read on the server only.
# Never prefix these with NEXT_PUBLIC_ and never commit .env.local.

# Required: turns the spoken request into { fix, device, when, near }.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Live calls: ElevenLabs places the call over the Vonage number imported as a SIP trunk.
# If any of the three ElevenLabs values or LIVE_SHOP_NUMBERS is empty, every shop is mock.
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
ELEVENLABS_AGENT_ID=agent_your-agent-id-here
ELEVENLABS_PHONE_NUMBER_ID=phnum_your-phone-number-id-here
# The Nth number is called for the Nth shop; shops without one use mock results.
LIVE_SHOP_NUMBERS=+66XXXXXXXXX
# Language the agent opens in: en | th | yue (unset = the agent's default, Thai).
CALL_LANGUAGE=en

# Backup only: the laptop caller in caller/ (see README). Set CALL_MODE=caller to use it.
# CALLER_URL=https://your-tunnel.ngrok-free.app
# CALLER_TOKEN=same-as-caller-LOCAL_CALL_TOKEN
# CALL_MODE=caller
