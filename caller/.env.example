# Copy to controller/.env AND connector/.env; neither reads a root .env.
# Keep these existing variable names. Values below are dummy placeholders.
API_KEY=your-vonage-api-key
API_SECRET=your-vonage-api-secret
APP_ID=your-vonage-application-id
SERVICE_PHONE_NUMBER=YOUR_RENTED_VONAGE_NUMBER_DIGITS_ONLY
VONAGE_PRIVATE_KEY_PATH=./.private.key
# Optional WebSocket-leg caller ID; blank uses SERVICE_PHONE_NUMBER.
WEBSOCKET_CALLER_ID=
PROCESSOR_SERVER=your-public-domain.example
MAX_CALL_DURATION=60
RECORD_CALLS=false
LOCAL_CALL_TOKEN=replace-with-a-long-random-secret
VERIFIED_TEST_NUMBER=YOUR_CONSENTING_TEST_DESTINATION_DIGITS_ONLY
ELEVENLABS_API_KEY=sk_your-elevenlabs-secret
ELEVENLABS_AGENT_ID=agent_your-agent-id
BUSINESS_NAME=Demo business
RECORD_ALL_AUDIO=false
# Read by connector but currently unused by its preserved initialization:
ELEVENLABS_VOICE_ID=your-voice-id-if-needed
ELEVENLABS_MODEL=
# Leave blank: wrapper forces controller 8001; connector defaults to 6000.
PORT=
VCR_PORT=
# NOT read by this caller; only for a separate Maps integration:
# GOOGLE_MAPS_API_KEY=your-places-api-new-key
